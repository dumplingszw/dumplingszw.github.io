---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 你好，我是 dumplingszw</h1>
			<p>
				这是我的个人博客，记录我在 <strong>Agent 开发</strong>、开源学习和日常折腾中的笔记与想法。
			</p>
			<p>下面是最近写的文章：</p>
			<p>
				<a href="/blog">前往博客 →</a> · <a href="/about">关于我 →</a> ·
				<a href="https://github.com/dumplingszw" target="_blank">GitHub</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
